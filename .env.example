# Server Configuration
PORT=3000
NODE_ENV=development

# Telegram Bot
TG_BOT_TOKEN=
TG_CHAT_ID=

# OTP -> Telegram forwarding bot
# Run standalone with: npm run telegram-bot
# Or set OTP_FORWARD_ENABLED=true to run it with the panel server.
OTP_FORWARD_ENABLED=false
# Leave blank in embedded mode; standalone mode must set this URL.
OTP_API_URL=
OTP_API_KEY=
OTP_POLL_INTERVAL_MS=5000
OTP_FETCH_COUNT=100
OTP_FORWARD_EXISTING=false
# OTP_BOT_STATE_FILE=./data/telegram-otp-state.json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Secret (for signed cookies / JWT signing)
SESSION_SECRET=cyrus-panel-change-this-to-a-long-random-string

# Admin Bootstrap (optional — creates admin on first start)
# Also: first user to register automatically becomes admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@cyrus.panel

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
