# Server Configuration
PORT=3000
NODE_ENV=development

# Telegram Bot (for credential forwarding)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Secret (for signed cookies / JWT signing)
SESSION_SECRET=cyrus-panel-change-this-to-a-long-random-string

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
