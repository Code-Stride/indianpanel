run = "node server.js"
entrypoint = "node server.js"

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "production"
PORT = "3000"

[deployment]
run = ["sh", "-c", "npm install && npm run build && node server.js"]
deploymentTarget = "cloudrun"
ignoreRunButton = false

[[ports]]
localPort = 3000
externalPort = 80
